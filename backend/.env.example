# Postgres. Read by the db service, and interpolated into the API's
# connection string in docker-compose.yml.
POSTGRES_DB=bookingdb
POSTGRES_USER=bookinguser
POSTGRES_PASSWORD=bookingpass

# Used when running the API outside Docker (dotnet run). The container gets
# Host=db instead -- docker-compose.yml sets it explicitly, and "environment"
# outranks "env_file".
ConnectionStrings__Default=Host=localhost;Port=5432;Database=bookingdb;Username=bookinguser;Password=bookingpass

# .NET reads "__" as its config-section separator, so Jwt__Secret becomes
# Jwt:Secret. These are passed to the container verbatim via env_file, so the
# names here must match the keys in appsettings.json exactly.
# Generate the secret with: openssl rand -base64 48
Jwt__Secret=replace-with-a-long-random-secret-openssl-rand-base64-48
Jwt__Issuer=booking-api
Jwt__Audience=booking-client
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7

# Frontend build arg. docker-compose.yml falls back to this same value.
VITE_API_URL=http://localhost:8080/api
